					        <version>3.5.5</version>
					        <configuration>
					          <suiteXmlFiles>
					            <suiteXmlFile>SmokeSuite.xml</suiteXmlFile>
					          </suiteXmlFiles>
					        </configuration>
					      </plugin>
					    
					</plugins>
					  		  	
  		  	
  		  	
